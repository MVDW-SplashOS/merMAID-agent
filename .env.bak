# merMAID configuration — copy to .env and edit.
# All settings come from environment variables; .env is the only config file.

# LLM provider: llamacpp (default) | openai (any OpenAI-compatible server) | ollama
MERMAID_PROVIDER=openai
MERMAID_PROVIDER_URL=http://192.16.3.44:8080
MERMAID_MODEL=qwen3.8-27b
MERMAID_NUM_CTX=98304

# API key for the provider, if required (OpenAI-compatible endpoints, proxies).
# MERMAID_API_KEY=

# Storage
#MERMAID_DB_PATH=/home/you/.local/share/mermaid/mermaid.db

# Working environment (directory agents operate on)
#MERMAID_ENVIRONMENT_ROOT=/home/you/Documents/GitHub/splashos_agent_enviroment

# Server bind address (keep on localhost; the agent has full host access)
MERMAID_HOST=127.0.0.1
MERMAID_PORT=7331

MERMAID_DEBUG=true

# Safety agent: reviews every bash command before execution (true/false).
# Off by default — commands run directly on the host without approval.
MERMAID_SAFETY_AGENT=false

# Optional profile (domain prompts + tools)
# MERMAID_PROFILE=
